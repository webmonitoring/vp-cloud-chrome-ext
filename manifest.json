{
  "manifest_version": 3,
  "name": "Visualping Cloud Jobs",
  "version": "0.2.0",
  "description": "Help create and manage Visualping Cloud monitoring jobs from the current page and keep their cookie state synced.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "cookies", "management", "offscreen", "storage", "tabs", "debugger", "scripting", "sidePanel", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "side_panel": {
    "default_path": "script_generator.html"
  },
  "action": {
    "default_title": "Visualping Cloud Jobs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}

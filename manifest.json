{
  "manifest_version": 3,
  "name": "Visualping Cloud Jobs",
  "version": "0.1.4",
  "description": "Help create and manage Visualping Cloud monitoring jobs from the current page and keep their cookie state synced.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "management",
    "offscreen",
    "storage",
    "tabs",
    "debugger",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://visualping.io/*",
    "https://*.visualping.io/*",
    "https://*.api.visualping.io/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*",
    "https://localhost:3000/*",
    "http://localhost:3000/*",
    "https://127.0.0.1/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "side_panel": {
    "default_path": "script_generator.html"
  },
  "action": {
    "default_title": "Visualping Cloud Jobs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
